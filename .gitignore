!geometry/demo/wasm-demo/**/*.html
!geometry/demo/wasm-demo/**/*.css
!geometry/demo/wasm-demo/**/*.js
!website/neural/**/*.html
!website/neural/**/*.css
!website/neural/**/*.js
# Ignore built pkg/ inside demo dirs (after negations so shell files are tracked)
