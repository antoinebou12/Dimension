# Demo shell files (HTML/CSS/JS) so website-build in CI can copy them into website/
!mathlib/demo/wasm-demo/**/*.html
!mathlib/demo/wasm-demo/**/*.css
!mathlib/demo/wasm-demo/**/*.js
!mathlib/demo/wasm-demo/**/*.json
!render/demo/wasm-demo/**/*.html
!render/demo/wasm-demo/**/*.css
!render/demo/wasm-demo/**/*.js
!kinematics/demo/wasm-demo/**/*.html
!kinematics/demo/wasm-demo/**/*.css
